!.idea/runConfigurations/ # Сохраняем конфигурации запуска
!.idea/dataSources/       # Сохраняем подключения к БД
!.idea/modules.xml        # Сохраняем структуру модулей
!.idea/vcs.xml           # Сохраняем настройки Git

